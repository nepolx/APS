@startuml
title СМО, вариант 18: диаграмма классов
skinparam classAttributeIconSize 0

enum TariffType {
  BASIC
  BUSINESS
  PREMIUM
}

enum TicketStatus {
  WAITING
  PROCESSING
  DONE
  REFUSED
}

enum AgentStatus {
  FREE
  BUSY
}

enum EventType {
  ARRIVAL
  SERVICE_COMPLETED
}

class Source {
  - id: String
  - tariff: TariffType
  - genIntervalMin: double
  - genIntervalMax: double
  - ticketCounter: int
  --
  + generateTicket(now: double): Ticket
  + nextInterval(): double
  + getId(): String
}
note right of Source
  ИБ, ИЗ2: nextInterval() ~ Uniform(genIntervalMin, genIntervalMax)
end note

class Ticket {
  - id: String
  - sourceId: String
  - tariff: TariffType
  - status: TicketStatus
  - slotIndex: int
  - createdAt: double
  - queuedAt: double
  - serviceStartedAt: double
  - finishedAt: double
  --
  + getPriority(): int
  + getSlotIndex(): int
  + getSourceId(): String
  + getQueuedAt(): double
  + getServiceStartedAt: double
  + markProcessing(now: double): void
  + markDone(now: double): void
  + markRefused(now: double): void
}

class TicketQueue {
  - slots: Ticket[]
  - capacity: int
  - queuePtr: int
  --
  + findFreeSlot(): int
  + insert(t: Ticket, slot: int, now: double): void
  + evictAt(now: double): Ticket
  + selectHighestPriority(): Ticket
  + freeSlot(slot: int): void
  + isEmpty(): boolean
  + getQueuePtr(): int
  + getSlots(): Ticket[]
  + getQueuePtr(): int
}
note right of TicketQueue
  Д1ОЗ1: findFreeSlot() ищет слот по кольцу от queuePtr
  Д1ОО1: evictAt() вытесняет заявку под queuePtr
  Д2Б4: selectHighestPriority() выбирает одну заявку
  с наивысшим приоритетом (при равенстве - более раннюю)
end note

class TicketRouter {
  - queue: TicketQueue
  - stats: Statistics
  --
  + onTicketGenerated(t: Ticket, now: double): void
}
note left of TicketRouter
  Диспетчер постановки.
  Работает только с буфером.
  Триггер: приход новой заявки.
end note

class AssignmentDispatcher {
  - queue: TicketQueue
  - agents: SupportAgent[]
  - agentPtr: int
  --
  + onQueueNotEmpty(now: double): AssignmentResult
  + onAgentFreed(a: SupportAgent, now: double): AssignmentResult
  - findFreeAgent(): SupportAgent
  - assign(t: Ticket, a: SupportAgent, now: double): AssignmentResult
}
note right of AssignmentDispatcher
  Диспетчер выбора.
  Д2П2: findFreeAgent() ищет прибор по кольцу от agentPtr.
  Триггеры: onQueueNotEmpty(), onAgentFreed().
  Нет свободного прибора - возвращает null.
end note

class AssignmentResult <<record>> {
  + agent: SupportAgent
  + serviceDuration: double
}

class SupportAgent {
  - id: String
  - status: AgentStatus
  - currentTicket: Ticket
  - serviceRateLambda: double
  - busyTime: double
  --
  + isFree(): boolean
  + process(t: Ticket, now: double): double
  + release(now: double): Ticket
  - serviceTime(): double
}
note right of SupportAgent
  ПЗ1: serviceTime() ~ Exponential(serviceRateLambda)
end note

class Statistics {
  - generatedCount: Map<String, Integer>
  - refusedBySource: Map<String, Integer>
  - sumWait: Map<String, Double>
  - sumService: Map<String, Double>
  --
  + recordGenerated(s: String): void
  + recordRefused(s: String): void
  + timeBuffAndService(t: Ticket): void
  + printStatistics(): void
}
note right of Statistics
  ОР1: таблица по источникам (pотк, TБП, Tобсл, Tпреб)
  и по приборам (Kисп = busyTime / totalTime)
end note

class SimulationEvent <<record>> {
  + time: double
  + type: EventType
  + agent: SupportAgent
  + source: Source
}

class EventCalendar {
  - events: PriorityQueue<SimulationEvent>
  --
  + schedule(event: SimulationEvent): void
  + nextEvent(): SimulationEvent
  + isEmpty(): boolean
}

class Simulation {
  - currentTime: double
  - endTime: double
  - maxGeneratedTickets: int
  - generatedTickets: int
  - sources: Source[]
  - agents: SupportAgent[]
  - eventCalendar: EventCalendar
  - router: TicketRouter
  - dispatcher: AssignmentDispatcher
  - stats: Statistics
  - queue: TicketQueue
  --
  + start(): void
  + runNextEvent(): void
  + runUntilFinished(): void
  + printState(): void
  - handleArrival(source: Source): void
  - handleServiceCompleted(agent: SupportAgent): void
  - scheduleNextArrival(source: Source): void
  - scheduleServiceCompletion(agent: SupportAgent, time: double): void
}

Simulation *-- EventCalendar
Simulation *-- "1..*" Source
Simulation *-- "1..*" SupportAgent
Simulation *-- TicketRouter
Simulation *-- AssignmentDispatcher
Simulation *-- Statistics

TicketRouter o-- TicketQueue : queue
TicketRouter o-- Statistics : stats

AssignmentDispatcher o-- TicketQueue : queue
AssignmentDispatcher o-- "*" SupportAgent : agents
AssignmentDispatcher ..> AssignmentResult

TicketQueue "1" *-- "0..*" Ticket : slots
SupportAgent "1" --> "0..1" Ticket : currentTicket

Source ..> Ticket : создаёт
EventCalendar *-- "0..*" SimulationEvent
SimulationEvent --> Source
SimulationEvent --> SupportAgent
SimulationEvent --> EventType
AssignmentResult --> SupportAgent

Ticket --> TariffType
Ticket --> TicketStatus
Source --> TariffType
SupportAgent --> AgentStatus

@enduml
