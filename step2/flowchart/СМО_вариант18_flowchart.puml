@startuml
title СМО, вариант 18: flowchart

|Simulation|
start
:Запланировать первое ARRIVAL от каждого источника;

while (Календарь не пуст?) is (да)
  |EventCalendar|
  :Извлечь ближайшее событие;
  |Simulation|
  :currentTime = время события;

  if (Тип события?) then (ARRIVAL)
    |Source|
    :Создать заявку (ИБ), вычислить интервал (ИЗ2);
    |Simulation|
    :recordGenerated, запланировать следующий ARRIVAL;
    |TicketRouter|
    if (Есть свободный слот по кольцу от QUEUE_PTR, Д1ОЗ1?) then (да)
      :Поставить заявку в слот N, QUEUE_PTR = N+1;
    else (нет)
      :Отказ заявке в слоте QUEUE_PTR (Д1ОО1),\nrecordRefused;
      :Поставить новую заявку на это место, QUEUE_PTR = P+1;
    endif
  else (SERVICE_COMPLETED)
    |SupportAgent|
    :Освободить прибор;
    |Statistics|
    :recordCompleted;
  endif

  |AssignmentDispatcher|
  if (Буфер не пуст?) then (да)
    if (Есть свободный прибор по кольцу от AGENT_PTR, Д2П2?) then (да)
      :Выбрать одну заявку с наивысшим приоритетом (Д2Б4);
      |SupportAgent|
      :Обслуживание заявки (ПЗ1);
      |AssignmentDispatcher|
      :AGENT_PTR = K+1;
      |EventCalendar|
      :Запланировать SERVICE_COMPLETED;
    else (нет)
      :Заявка остаётся в буфере до освобождения прибора;
    endif
  else (нет)
    :Назначать нечего;
  endif

  |Simulation|
  :Показать состояние: календарь, источники, буфер, приборы,\nуказатели, % отказа, ждать Enter;
endwhile (нет)

|Statistics|
:Вывести таблицы результатов (ОР1);
stop
@enduml
