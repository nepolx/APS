@startuml

start
|Simulation|
:Инициализация Simulation и EventCalendar;
:Запланировать первые события поступления заявок;
while (Есть события в EventCalendar и не достигнут конец моделирования?) is (да)
  :Извлечь ближайшее SimulationEvent;
  :Перевести текущее время к времени события;

|Source|
:Создается ticket и передается TicketRouter (ИЗ2);

|TicketRouter|
if (Queue есть свободный слот?) then (да)
  :Ticket кладется в буфер (Д1ОЗ1);
else (нет)
  :Отказ заявки, стоящей на позиции указателя (Д1ОО1);
  :Statistics.recordRefused();
  :Ticket встает на место указателя;
endif
:Statistics.recordGenerated();

|AssignmentDispatcher|
if (Оператор свободен?) then (да)
  :Поиск свободного оператора по кольцу (Д2П2);
else (нет)
  repeat
    :Ожидание освобождения оператора;
  repeat while (Оператор освободился?) is (нет) not (да)
endif
:Выбор заявки с наивысшим приоритетом источника из буфера (Д2Б4);
:Назначение заявки оператору K (Д2П2);

|SupportAgent|
:Обработка заявки (ПЗ1 — экспоненциальный закон обслуживания);
:Statistics.recordProcessed();
|EventCalendar|
:Запланировать событие окончания обслуживания;
|Simulation|
endwhile (нет)
:Вывести результаты моделирования;
stop
@enduml
